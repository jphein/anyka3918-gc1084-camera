#!/bin/sh
# Minimal fast control endpoint for the Anyka AK3918 hack web interface.
#
#   GET /cgi-bin/ctl?token=<token>&command=<cmd>
#
# The stock /cgi-bin/webui is slow (0.2-1.0s) because every request sources
# `header`, which URL-decodes QUERY_STRING with a per-character bash loop that
# spawns subshells - painful on a 400MHz ARM926 - and then renders the whole
# control page. This does neither: it parses two known-safe parameters, writes a
# single whitelisted line into the ptz_daemon FIFO, and returns "OK".
#
# Same token auth as the stock UI: ?token= must match line 1 of /tmp/token.txt,
# which /cgi-bin/login_validate.sh writes on successful login.
#
# Commands are WHITELISTED. Never interpolate $c into a shell command - it comes
# straight off the network.
#
# Install to: /mnt/anyka_hack/web_interface/www/cgi-bin/ctl  (mode 755)

echo "Content-type: text/plain"
echo ""

t=""
c=""
f=""
for kv in $(echo "$QUERY_STRING" | tr '&' ' '); do
  case "$kv" in
    token=*) t="${kv#token=}" ;;
    command=*) c="${kv#command=}" ;;
    file=*) f="${kv#file=}" ;;
  esac
done

if [ ! -f /tmp/token.txt ]; then
  echo "ERR notoken"
  exit 0
fi
if [ "$t" != "$(sed 1q /tmp/token.txt)" ]; then
  echo "ERR auth"
  exit 0
fi

case "$c" in
  up|down|left|right|left_up|right_up|left_down|right_down)
    echo "$c" > /tmp/ptz.daemon ;;
  init_ptz|init_ir)
    echo "$c" > /tmp/ptz.daemon ;;
  # Write the pin DIRECTLY. Do NOT route this through the ptz daemon's
  # `set_ir_cut`: on this kernel the daemon's ak_drv_ir_init stats
  # /sys/user-gpio/gpio-ircut_a and gpio-ircut_b, both of which are absent
  # (this build names them ircut_a/ircut_b), so init returns -1 and
  # ak_drv_ir_set_ircut bails before writing anything. It reports success
  # regardless - camera_set_ircut is a sprintf into a shell call that always
  # returns 0 - which is why the FIFO route looked like it worked for months.
  # 1 = filter IN = normal colour. 0 = filter OUT = magenta. Allow 4-8s to move.
  ircut_on)
    echo 1 > /sys/user-gpio/ircut_a ;;
  ircut_off)
    echo 0 > /sys/user-gpio/ircut_a ;;
  white_led_on)
    echo 1 > /sys/user-gpio/WHITE_LED ;;
  white_led_off)
    echo 0 > /sys/user-gpio/WHITE_LED ;;
  ir_led_on)
    echo 1 > /sys/user-gpio/IR_LED ;;
  ir_led_off)
    echo 0 > /sys/user-gpio/IR_LED ;;
  status)
    printf 'ircut_a=%s white_led=%s ir_led=%s\n' \
      "$(cat /sys/user-gpio/ircut_a 2>/dev/null)" \
      "$(cat /sys/user-gpio/WHITE_LED 2>/dev/null)" \
      "$(cat /sys/user-gpio/IR_LED 2>/dev/null)"
    exit 0 ;;
  play)
    # $f comes straight off the network and is interpolated into a command, so
    # it is validated hard: bare name only, no path, no extension, no dots, no
    # slashes. The directory and the .mp3 suffix are supplied by us, never by
    # the caller. Reject anything with a character outside [A-Za-z0-9_-].
    case "$f" in
      ""|*[!A-Za-z0-9_-]*)
        echo "ERR file"
        exit 0 ;;
    esac
    if [ ! -f "/mnt/sounds/$f.mp3" ]; then
      echo "ERR nofile"
      exit 0
    fi
    # SPK_PA is the speaker power amplifier and sits at 0 on a cold boot;
    # without it the decoder runs happily and you hear nothing.
    echo 1 > /sys/user-gpio/SPK_PA
    # Every clip in /mnt/sounds is standardised to 16kHz mono mp3, so the rate is
    # fixed here. This matters: ak_adec_demo takes the sample rate as an argument
    # and does NOT read it from the file, so a mismatch plays at the wrong speed
    # and pitch. The old value here was 41100 - both a typo for 44100 and wrong
    # for a 16kHz file, which made speech come out ~2.5x fast.
    # setsid so the player outlives this CGI process.
    # NOTE: ak_adec_demo has no working volume control - attenuate before upload.
    setsid ak_adec_demo 16000 1 mp3 "/mnt/sounds/$f.mp3" </dev/null >/dev/null 2>&1 &
    echo "OK"
    exit 0 ;;
  sounds)
    ls /mnt/sounds/ 2>/dev/null | sed 's/\.mp3$//' | tr '\n' ' '
    echo
    exit 0 ;;
  *)
    echo "ERR cmd"
    exit 0 ;;
esac

echo "OK"

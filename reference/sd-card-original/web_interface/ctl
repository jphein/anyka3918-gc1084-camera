#!/bin/sh
# Minimal fast control endpoint for the Anyka AK3918 hack web interface.
#
#   GET /cgi-bin/ctl?token=<token>&command=<cmd>
#
# The stock /cgi-bin/webui is slow (0.2-1.0s) because every request sources
# `header`, which URL-decodes QUERY_STRING with a per-character bash loop that
# spawns subshells - painful on a 400MHz ARM926 - and then renders the whole
# control page. This does neither: it parses two known-safe parameters, writes a
# single whitelisted line into the ptz_daemon FIFO, and returns "OK".
#
# Same token auth as the stock UI: ?token= must match line 1 of /tmp/token.txt,
# which /cgi-bin/login_validate.sh writes on successful login.
#
# Commands are WHITELISTED. Never interpolate $c into a shell command - it comes
# straight off the network.
#
# Install to: /mnt/anyka_hack/web_interface/www/cgi-bin/ctl  (mode 755)

echo "Content-type: text/plain"
echo ""

t=""
c=""
f=""
v=""
for kv in $(echo "$QUERY_STRING" | tr '&' ' '); do
  case "$kv" in
    token=*) t="${kv#token=}" ;;
    command=*) c="${kv#command=}" ;;
    file=*) f="${kv#file=}" ;;
    level=*) v="${kv#level=}" ;;
  esac
done

if [ ! -f /tmp/token.txt ]; then
  echo "ERR notoken"
  exit 0
fi
if [ "$t" != "$(sed 1q /tmp/token.txt)" ]; then
  echo "ERR auth"
  exit 0
fi

case "$c" in
  up|down|left|right|left_up|right_up|left_down|right_down)
    echo "$c" > /tmp/ptz.daemon ;;
  init_ptz|init_ir)
    echo "$c" > /tmp/ptz.daemon ;;
  # Write the pin DIRECTLY. Do NOT route this through the ptz daemon's
  # `set_ir_cut`: on this kernel the daemon's ak_drv_ir_init stats
  # /sys/user-gpio/gpio-ircut_a and gpio-ircut_b, both of which are absent
  # (this build names them ircut_a/ircut_b), so init returns -1 and
  # ak_drv_ir_set_ircut bails before writing anything. It reports success
  # regardless - camera_set_ircut is a sprintf into a shell call that always
  # returns 0 - which is why the FIFO route looked like it worked for months.
  # 1 = filter IN = normal colour. 0 = filter OUT = magenta. Allow 4-8s to move.
  ircut_on)
    echo 1 > /sys/user-gpio/ircut_a ;;
  ircut_off)
    echo 0 > /sys/user-gpio/ircut_a ;;
  white_led_on)
    echo 1 > /sys/user-gpio/WHITE_LED ;;
  white_led_off)
    echo 0 > /sys/user-gpio/WHITE_LED ;;
  ir_led_on)
    echo 1 > /sys/user-gpio/IR_LED ;;
  ir_led_off)
    echo 0 > /sys/user-gpio/IR_LED ;;
  status)
    printf 'ircut_a=%s white_led=%s ir_led=%s\n' \
      "$(cat /sys/user-gpio/ircut_a 2>/dev/null)" \
      "$(cat /sys/user-gpio/WHITE_LED 2>/dev/null)" \
      "$(cat /sys/user-gpio/IR_LED 2>/dev/null)"
    exit 0 ;;
  play)
    # $f comes straight off the network and is interpolated into a command, so
    # it is validated hard: bare name only, no path, no extension, no dots, no
    # slashes. The directory and the .mp3 suffix are supplied by us, never by
    # the caller. Reject anything with a character outside [A-Za-z0-9_-].
    case "$f" in
      ""|*[!A-Za-z0-9_-]*)
        echo "ERR file"
        exit 0 ;;
    esac
    if [ ! -f "/mnt/sounds/$f.mp3" ]; then
      echo "ERR nofile"
      exit 0
    fi
    # SPK_PA is the speaker power amplifier and sits at 0 on a cold boot;
    # without it the decoder runs happily and you hear nothing.
    echo 1 > /sys/user-gpio/SPK_PA
    # Every clip in /mnt/sounds is standardised to 16kHz mono mp3, so the rate is
    # fixed here. This matters: ak_adec_demo takes the sample rate as an argument
    # and does NOT read it from the file, so a mismatch plays at the wrong speed
    # and pitch. The old value here was 41100 - both a typo for 44100 and wrong
    # for a 16kHz file, which made speech come out ~2.5x fast.
    # setsid so the player outlives this CGI process.
    # VOLUME. ak_adec_demo hardcodes the DAC volume to 6 (the max of a 0-6 range)
    # with no CLI flag and no getenv, so upstream concluded "volume control fails
    # when running" and told everyone to pre-attenuate the mp3. The control never
    # failed - it was never exposed. A one-byte patch to the `mov r1,#6` immediate
    # feeding ak_ao_set_dac_volume gives a real hardware volume, and because that
    # value goes to the DAC ioctl it sits DOWNSTREAM of the ASLC compressor and
    # cannot be normalised away. Pre-attenuating the file cannot work: the file is
    # upstream of ASLC, which levels it straight back up.
    #
    # &level=N (N in 1..6) runs ak_adec_demo.volN, which calls
    # ak_ao_set_dac_volume(N). The driver is then handed DEV volume N-1, so the six
    # rungs are DEV 0..5. BOTH numbers appear in the player's own log and they are
    # NOT the same number - "set volume N" then "set DEV volume N-1". Quote whichever
    # you mean; saying just "DAC volume" is how this got misread once already.
    #
    # Level 1 (DEV 0) IS the codec floor. Do NOT add a .vol0 as a seventh rung:
    # ak_ao_set_dac_volume(0) takes a DIFFERENT branch entirely - ioctl 0x40045010
    # with 0, which MUTES and also tears down the ASLC filter handle. It is not a
    # quieter step, it is off.
    #
    # Absent, malformed or out-of-range falls back to the default binary, which is
    # level 4. The final -x fallback is to the stock /usr/bin copy so that a
    # missing card file can never wedge the speaker into silence.
    BIN=/mnt/anyka_hack/ak_adec_demo/ak_adec_demo
    case "$v" in
      [1-6]) [ -x "$BIN.vol$v" ] && BIN="$BIN.vol$v" ;;
    esac
    [ -x "$BIN" ] || BIN=ak_adec_demo
    setsid "$BIN" 16000 1 mp3 "/mnt/sounds/$f.mp3" </dev/null >/dev/null 2>&1 &
    echo "OK"
    exit 0 ;;
  stats)
    # One call, one bundle, for the HA telemetry tile. Fixed key set, always
    # present, null when unavailable - same convention as whoami.sh --json, so the
    # HA side has one parser shape rather than two.
    #
    # COST IS THE DESIGN CONSTRAINT and fork() is what costs, not the data. Measured
    # on this camera at load ~5: four $(...) substitutions = 0.414s median, while
    # iwconfig alone = 0.105s. A glob of /proc/[0-9]*/stat to find the pid without
    # pidof measured WORSE (0.437s vs 0.206s) - opening 78 files beats one fork only
    # in theory. So: exactly two forks, pidof and one awk that reads every /proc
    # source itself.
    #
    # DELIBERATELY NULL, do not "fix" these by filling them in:
    #   signal_level / noise_level - the ZT9101UV20 driver reports these as a
    #     CONSTANT 100/100 and 0/100. Sampled four times while link_quality moved
    #     60->66->60->57, they never budged. They are stubs, not measurements.
    #   fps - there is no source. Not in gergesettings, not in the app argv, and no
    #     anyka/video entry under /proc. The "20fps" in docs/home-assistant.md has no
    #     traceable origin. Reporting a number we cannot measure is worse than a gap:
    #     use encoder_cpu_jiffies instead (below).
    #
    # video_width/height come from the RUNNING process argv, not the config file, so
    # they describe what is actually encoding. Still "configured" - it is the app's
    # input, not a measurement of its output - hence video_dims_source.
    #
    # encoder_cpu_jiffies is the honest substitute for fps: cumulative CPU of the
    # encoder. HA already polls on a timer, so it can differentiate two samples into
    # a rate for free:  pct = 100*(d_jiffies/hz)/d_uptime_s. Both fields are in this
    # same bundle and uptime_s is monotonic, so the arithmetic survives NTP steps.
    # A stalled encoder shows as a flat line - which is this camera's characteristic
    # failure (silence with the process still alive).
    PID=$(pidof libre_anyka_app)
    iwconfig wlan0 2>/dev/null | awk -v PID="$PID" '
      /ESSID:/        { if (match($0,/ESSID:"[^"]*"/))            ssid=substr($0,RSTART+7,RLENGTH-8) }
      /Access Point:/ { if (match($0,/Access Point: [0-9A-Fa-f:]+/)) ap=substr($0,RSTART+14,RLENGTH-14) }
      /Frequency:/    { if (match($0,/Frequency:[0-9.]+/))        fq=substr($0,RSTART+10,RLENGTH-10)*1000 }
      /Bit Rate[:=]/  { if (match($0,/Bit Rate[:=][0-9.]+/))      br=substr($0,RSTART+9,RLENGTH-9) }
      END {
        while ((getline l < "/proc/loadavg") > 0) { split(l,a," "); l1=a[1]; l5=a[2]; l15=a[3] }
        while ((getline l < "/proc/uptime")  > 0) { split(l,a," "); up=int(a[1]) }
        while ((getline l < "/proc/net/wireless") > 0)
          if (l ~ /wlan0:/) { gsub(/\./,"",l); split(l,a," "); lq=a[3] }
        while ((getline l < "/proc/meminfo") > 0) { split(l,a,"[ \t]+")
          if      (a[1]=="MemTotal:") mt=a[2]; else if (a[1]=="MemFree:") mf=a[2]
          else if (a[1]=="Buffers:")  bu=a[2]; else if (a[1]=="Cached:")  ca=a[2] }
        if (PID != "") {
          while ((getline l < ("/proc/" PID "/stat")) > 0) { n=split(l,a," "); if (n>15) cpu=a[14]+a[15] }
          nx=0
          while ((getline l < ("/proc/" PID "/cmdline")) > 0) {
            if (nx==1) { vw=l; nx=0 } else if (nx==2) { vh=l; nx=0 }
            if (l=="-w") nx=1; else if (l=="-h") nx=2 }
        }
        while ((getline l < "/proc/stat") > 0)
          if (l ~ /^cpu /) { n=split(l,a," "); ct=0; for (k=2;k<=n;k++) ct+=a[k]; ci=a[5] }
        while ((getline l < "/proc/net/tcp") > 0) {
          n=split(l,a," ")
          if (n>3) { split(a[2],pp,":"); if (pp[2]=="022A" && a[4]=="01") rc++ } }
        while (("df -k /mnt /etc/jffs2 /data 2>/dev/null" | getline l) > 0) {
          n=split(l,a," ")
          if (n>=6) { if      (a[6]=="/mnt")       { sdt=a[2]; sdf=a[4] }
                      else if (a[6]=="/etc/jffs2") { jt=a[2];  jf=a[4]  }
                      else if (a[6]=="/data")      { dt=a[2];  dfr=a[4] } } }
        q="\""
        printf "{"
        printf "%suptime_s%s:%d,", q,q, up
        printf "%sload1%s:%s,%sload5%s:%s,%sload15%s:%s,", q,q,l1, q,q,l5, q,q,l15
        printf "%smem_total_kb%s:%d,%smem_free_kb%s:%d,%smem_avail_kb%s:%d,", q,q,mt, q,q,mf, q,q,mf+bu+ca
        printf "%slink_quality%s:%s,",  q,q, (lq==""   ? "null" : lq)
        printf "%sssid%s:%s,",          q,q, (ssid=="" ? "null" : q ssid q)
        printf "%sap_bssid%s:%s,",      q,q, (ap==""   ? "null" : q ap q)
        printf "%sfreq_mhz%s:%s,",      q,q, (fq==""   ? "null" : sprintf("%d",fq))
        printf "%sbitrate_mbps%s:%s,",  q,q, (br==""   ? "null" : br)
        printf "%svideo_width%s:%s,",   q,q, (vw==""   ? "null" : vw)
        printf "%svideo_height%s:%s,",  q,q, (vh==""   ? "null" : vh)
        printf "%svideo_dims_source%s:%sconfigured%s,", q,q,q,q
        printf "%sencoder_pid%s:%s,",   q,q, (PID==""  ? "null" : PID)
        printf "%sencoder_cpu_jiffies%s:%s,", q,q, (cpu=="" ? "null" : cpu)
        printf "%scpu_total_jiffies%s:%s,", q,q, (ct=="" ? "null" : ct)
        printf "%scpu_idle_jiffies%s:%s,",  q,q, (ci=="" ? "null" : ci)
        printf "%srtsp_clients%s:%d,",      q,q, rc+0
        printf "%sdisk_sd_total_kb%s:%s,%sdisk_sd_free_kb%s:%s,",       q,q,(sdt==""?"null":sdt), q,q,(sdf==""?"null":sdf)
        printf "%sdisk_jffs2_total_kb%s:%s,%sdisk_jffs2_free_kb%s:%s,", q,q,(jt==""?"null":jt),  q,q,(jf==""?"null":jf)
        printf "%sdisk_data_total_kb%s:%s,%sdisk_data_free_kb%s:%s,",   q,q,(dt==""?"null":dt),  q,q,(dfr==""?"null":dfr)
        printf "%shz%s:100,", q,q
        printf "%ssignal_level%s:null,%snoise_level%s:null,%sfps%s:null", q,q,q,q,q,q
        printf "}\n"
      }'
    exit 0 ;;
  sounds)
    ls /mnt/sounds/ 2>/dev/null | sed 's/\.mp3$//' | tr '\n' ' '
    echo
    exit 0 ;;
  *)
    echo "ERR cmd"
    exit 0 ;;
esac

echo "OK"
